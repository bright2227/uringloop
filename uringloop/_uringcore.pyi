from collections.abc import Iterable
from typing import Final, Literal, Self

ABI_VERSION: Final[int]
OP_NOP: Final[int]
OP_TIMEOUT: Final[int]
OP_ASYNC_CANCEL: Final[int]
OP_RECV: Final[int]
OP_SEND: Final[int]
OP_READ: Final[int]
OP_WRITE: Final[int]
OP_POLL_ADD: Final[int]
OP_SEND_ZC: Final[int]
OP_PROVIDE_BUFFERS: Final[int]

class ProtocolDispatcher:
    def __init__(self, protocol: object) -> None: ...
    def get_protocol(self) -> object: ...
    def set_protocol(self, protocol: object) -> None: ...
    def connection_made(self, transport: object) -> object: ...
    def data_received(self, data: bytes) -> object: ...
    def eof_received(self) -> object: ...
    def connection_lost(self, exception: BaseException | None) -> object: ...
    def pause_writing(self) -> object: ...
    def resume_writing(self) -> object: ...

class StreamTransport:
    def __init__(
        self, loop: object, sock: object, protocol: object, waiter: object = None,
        extra: dict[str, object] | None = None, server: object = None, owner: object = None,
    ) -> None: ...
    def write(self, data: object) -> None: ...
    def writelines(self, data: Iterable[object]) -> None: ...
    def close(self) -> None: ...
    def abort(self) -> None: ...
    def _close_for_loop(self) -> None: ...
    def write_eof(self) -> None: ...
    def can_write_eof(self) -> bool: ...
    def is_closing(self) -> bool: ...
    def is_reading(self) -> bool: ...
    def pause_reading(self) -> None: ...
    def resume_reading(self) -> None: ...
    def get_protocol(self) -> object: ...
    def set_protocol(self, protocol: object) -> None: ...
    def get_extra_info(self, name: str, default: object = None) -> object: ...
    def get_write_buffer_size(self) -> int: ...
    def get_write_buffer_limits(self) -> tuple[int, int]: ...
    def set_write_buffer_limits(self, high: int | None = None, low: int | None = None) -> None: ...
    def _read_done(self, completion: Completion) -> None: ...
    def _write_done(self, completion: Completion) -> None: ...

class LoopCore:
    def __init__(self, max_ready: int | None = None, max_timers: int | None = None) -> None: ...
    @property
    def ready_count(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    def enqueue_ready(self, handle: object) -> None: ...
    def take_ready_batch(self, limit: int) -> list[object]: ...
    def clear_ready(self) -> None: ...
    @property
    def timer_count(self) -> int: ...
    @property
    def cancelled_timer_count(self) -> int: ...
    def schedule_timer(self, handle: object, when: float) -> None: ...
    def next_deadline(self) -> float | None: ...
    def promote_due(self, now: float, resolution: float, limit: int) -> int: ...
    def compact_timers(self) -> int: ...
    def clear_timers(self) -> None: ...
    def prepare_tick(self, now: float, maximum_timeout: float, immediate: bool) -> float | None: ...
    def finish_tick(
        self, now: float, resolution: float, timer_budget: int, ready_budget: int
    ) -> tuple[list[object], bool, int]: ...
    @property
    def tick_count(self) -> int: ...
    @property
    def ready_budget_exhaustions(self) -> int: ...
    @property
    def timer_budget_exhaustions(self) -> int: ...
    def close(self) -> None: ...

class EventFD:
    def __init__(self, setup_errno: int = 0) -> None: ...
    @property
    def signalled(self) -> bool: ...
    @property
    def closed(self) -> bool: ...
    @property
    def write_count(self) -> int: ...
    @property
    def drain_count(self) -> int: ...
    def notify(self) -> bool: ...
    def drain(self) -> int: ...
    def fileno(self) -> int: ...
    def close(self) -> None: ...

class Request:
    @property
    def state(
        self,
    ) -> Literal[
        "prepared",
        "submitted",
        "cancel_pending",
        "operation_complete",
        "notification_pending",
        "released",
    ]: ...
    @property
    def kind(
        self,
    ) -> Literal[
        "nop",
        "timeout",
        "cancel",
        "recv",
        "send",
        "send_zc",
        "read",
        "write",
        "poll",
    ]: ...
    @property
    def done(self) -> bool: ...
    @property
    def cancelled(self) -> bool: ...
    @property
    def result(self) -> int | None: ...
    @property
    def flags(self) -> int: ...

class Completion:
    @property
    def request(self) -> Request: ...
    @property
    def state(
        self,
    ) -> Literal[
        "submitted",
        "cancel_pending",
        "operation_complete",
        "notification_pending",
        "released",
    ]: ...
    @property
    def result(self) -> int: ...
    @property
    def flags(self) -> int: ...
    @property
    def final(self) -> bool: ...
    @property
    def buffer(self) -> ProvidedBuffer | None: ...

class ProvidedBuffer:
    @property
    def buffer_id(self) -> int: ...
    @property
    def length(self) -> int: ...
    @property
    def released(self) -> bool: ...
    def to_bytes(self) -> bytes: ...
    def release(self) -> None: ...

class Ring:
    def abandon_prepared(self, request: Request) -> None: ...
    def __init__(
        self,
        entries: int = 256,
        cq_entries: int | None = None,
        supported_opcodes: Iterable[int] | None = None,
        flags: int = 0,
    ) -> None: ...
    @property
    def sq_entries(self) -> int: ...
    @property
    def cq_entries(self) -> int: ...
    @property
    def features(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    @property
    def pending(self) -> int: ...
    @property
    def supported_opcodes(self) -> frozenset[int]: ...
    @property
    def cq_ready(self) -> int: ...
    @property
    def cq_overflowed(self) -> bool: ...
    @property
    def cq_dropped(self) -> int: ...
    @property
    def buffer_pool_entries(self) -> int: ...
    @property
    def buffer_size(self) -> int: ...
    @property
    def buffer_group_id(self) -> int: ...
    @property
    def buffers_available(self) -> int: ...
    @property
    def buffers_in_use(self) -> int: ...
    @property
    def buffer_pool_bytes(self) -> int: ...
    def prepare_nop(self) -> Request: ...
    def prepare_timeout(self, delay_ns: int) -> Request: ...
    def prepare_cancel(self, request: Request) -> Request: ...
    def prepare_recv(self, file: object, buffer: object, flags: int = 0) -> Request: ...
    def prepare_recv_multishot(self, file: object, flags: int = 0) -> Request: ...
    def prepare_send(self, file: object, buffer: object, flags: int = 0) -> Request: ...
    def prepare_send_zc(self, file: object, buffer: object, flags: int = 0) -> Request: ...
    def prepare_read(self, file: object, buffer: object, offset: int = -1) -> Request: ...
    def prepare_write(self, file: object, buffer: object, offset: int = -1) -> Request: ...
    def prepare_poll(self, file: object, mask: int) -> Request: ...
    def setup_buffer_pool(
        self,
        entries: int,
        buffer_size: int,
        group_id: int = 0,
    ) -> None: ...
    def submit(self) -> int: ...
    def reap(self, max_completions: int = 64) -> list[Completion]: ...
    def wait(
        self,
        timeout_ns: int | None = None,
        max_completions: int = 64,
    ) -> list[Completion]: ...
    def supports(self, opcode: int) -> bool: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: object | None,
    ) -> Literal[False]: ...
